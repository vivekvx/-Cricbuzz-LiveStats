# Subscribe to Cricbuzz Cricket v1 on RapidAPI. Never commit the actual key.
RAPIDAPI_KEY=
CRICBUZZ_API_BASE=https://cricbuzz-cricket.p.rapidapi.com
CRICBUZZ_API_HOST=cricbuzz-cricket.p.rapidapi.com
# Optional directory override. The app maintains sample.sqlite3 and live.sqlite3.
# CRICBUZZ_DATA_DIR=/absolute/path/to/data
